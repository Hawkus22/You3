{
  "name": "you3",
  "productName": "You3",
  "version": "0.2.0",
  "description": "Convertisseur de vidéos YouTube, Facebook et TikTok en MP3 - Hawkus Corp.",
  "author": "Vachon Marc-Olivier",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.js && node scripts/generate-help.js",
    "start": "npm run build && node scripts/start.js .",
    "icon": "node scripts/start.js scripts/make-icon.js",
    "dist": "npm run build && electron-builder",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "fr.hawkuscorp.you3",
    "productName": "You3",
    "copyright": "Copyright © 2026 Hawkus Corp. — Vachon Marc-Olivier",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "You3",
      "artifactName": "You3-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "language": "1036"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Hawkus22",
        "repo": "You3"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.14",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "ffmpeg-static@5.3.0": true
  }
}
